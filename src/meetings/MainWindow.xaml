<Window x:Class="MeetingNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Notes · AI Terminals"
        Width="1080" Height="760" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F3F6F8">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" BorderBrush="#DCE6EA" BorderThickness="0,0,0,1" Padding="26,19">
      <StackPanel>
        <TextBlock Text="MEETING NOTES" Foreground="#176F71" FontWeight="Bold" FontSize="11"/>
        <TextBlock Text="Dalla trascrizione alla minuta pronta per Outlook" FontWeight="SemiBold" FontSize="21" Margin="0,5,0,0"/>
        <TextBlock Text="Tutto il flusso locale fino alla chiamata IA. Nessun bot nelle riunioni."
                   Foreground="#647887" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="20,18,20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#DCE6EA" BorderThickness="1" CornerRadius="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22,21,22,23">
            <TextBlock Text="Nuova minuta" FontWeight="Bold" FontSize="17"/>
            <TextBlock Text="Seleziona la trascrizione e il modello da utilizzare."
                       Foreground="#647887" Margin="0,5,0,20" TextWrapping="Wrap"/>

            <TextBlock Text="Cartella di lavoro" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="WorkspaceInput" Grid.Column="0" IsReadOnly="True"
                       ToolTip="Percorso locale dei file di questa riunione"/>
              <Button x:Name="BrowseWorkspaceButton" Grid.Column="1" Margin="7,0,0,0"
                      Content="Scegli cartella..." Click="BrowseWorkspace_Click"/>
            </Grid>
            <TextBlock Text="I WAV, i TXT e le minute sono salvati qui, in sottocartelle separate."
                       Foreground="#647887" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <TextBlock Text="Titolo riunione" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="TitleInput" Text="Riunione di lavoro" Margin="0,0,0,16"/>

            <TextBlock Text="Trascrizione TXT · UTF-8" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TranscriptInput" Grid.Column="0" IsReadOnly="True"
                       Text="Nessun file selezionato" VerticalContentAlignment="Center"
/>
              <Button Grid.Column="1" Margin="7,0,0,0" Content="Sfoglia..." Click="BrowseTranscript_Click"/>
            </Grid>

            <TextBlock Text="Testo trascrizione (modificabile)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="TranscriptEditor" AcceptsReturn="True" AcceptsTab="False"
                     TextWrapping="Wrap" Height="118" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" MaxLength="2000000"
                     ToolTip="Inserisci il testo manualmente o importalo da un TXT."/>
            <WrapPanel Margin="0,7,0,17">
              <Button x:Name="NewTranscriptButton" Content="Nuovo testo" Click="NewTranscript_Click" Margin="0,0,8,0"/>
              <Button x:Name="SaveTranscriptButton" Content="Salva TXT" Click="SaveTranscript_Click"/>
            </WrapPanel>

            <TextBlock Text="Provider IA" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="ProviderInput" SelectionChanged="ProviderInput_SelectionChanged" Margin="0,0,0,16">
              <ComboBoxItem Content="Claude Code (CLI aziendale)" Tag="Claude"/>
              <ComboBoxItem Content="Codex CLI" Tag="Codex"/>
              <ComboBoxItem Content="Simulazione offline (Mock)" Tag="Mock"/>
            </ComboBox>

            <StackPanel x:Name="MockPanel" Visibility="Collapsed" Margin="0,0,0,14">
              <TextBlock Text="Risposta JSON di test" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MockInput" Grid.Column="0" IsReadOnly="True" Text="Nessun JSON selezionato"/>
                <Button Grid.Column="1" Margin="7,0,0,0" Content="Sfoglia..." Click="BrowseMock_Click"/>
              </Grid>
            </StackPanel>

            <Grid Margin="0,0,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Semplificazione italiano tecnico" FontWeight="SemiBold" Grid.Column="0"/>
              <TextBlock x:Name="StyleValue" Text="80%" Grid.Column="1" FontWeight="Bold" Foreground="#176F71"/>
            </Grid>
            <Slider x:Name="StyleInput" Minimum="40" Maximum="100" Value="80"
                    IsSnapToTickEnabled="True" TickFrequency="10"
                    ValueChanged="StyleInput_ValueChanged"
                    Margin="0,0,0,17"/>

            <Border Background="#F5FAFC" BorderBrush="#DCE6EA" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="Prova registrazione audio" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Acquisizione locale in WAV, senza inviare nulla all'IA."
                           Foreground="#647887" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"/>
                <WrapPanel Margin="0,0,0,8">
                  <CheckBox x:Name="CaptureMicrophone" Content="Microfono" IsChecked="True" Margin="0,0,18,0"/>
                  <CheckBox x:Name="CaptureSystem" Content="Audio del PC" IsChecked="True"/>
                </WrapPanel>
                <CheckBox x:Name="RecordingPermission" Margin="0,3,0,12" FontSize="11"
                          Content="Confermo di poter registrare questa prova in base alle policy aziendali."/>
                <WrapPanel>
                  <Button x:Name="StartAudioButton" Content="● Registra" Click="StartAudio_Click" Padding="12,7"
                          Background="#176F71" Foreground="White" BorderBrush="#176F71" Margin="0,0,8,8"/>
                  <Button x:Name="StopAudioButton" Content="■ Ferma" Click="StopAudio_Click" Padding="12,7"
                          IsEnabled="False" Margin="0,0,8,8"/>
                  <Button x:Name="OpenAudioFolderButton" Content="File audio" Click="OpenAudioFolder_Click"
                          Padding="12,7" IsEnabled="False" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock x:Name="AudioStatusText" FontSize="11" Foreground="#647887"
                           TextWrapping="Wrap" Text="Pronto. Nessuna registrazione in corso."/>
              </StackPanel>
            </Border>

            <Border Background="#F5FAFC" BorderBrush="#DCE6EA" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="Trascrizione offline · Whisper" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Elaborazione CPU in locale, nessun upload dell'audio."
                           Foreground="#647887" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"/>
                <TextBlock Text="Modello multilingua GGML (.bin)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="WhisperModelInput" IsReadOnly="True" Text="Nessun modello selezionato"
                           Grid.Column="0" ToolTip="Seleziona un modello .bin locale, non la variante .en."/>
                  <Button Grid.Column="1" Content="Sfoglia..." Click="BrowseModel_Click" Margin="7,0,0,0"/>
                </Grid>
                <TextBlock Text="Registrazione WAV da trascrivere" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="RecordingInput" IsReadOnly="True" Text="Registra oppure scegli un WAV"
                           Grid.Column="0" ToolTip="I WAV microfono.wav e audio-pc.wav della stessa cartella possono essere elaborati insieme."/>
                  <Button Grid.Column="1" Content="Sfoglia WAV..." Click="BrowseRecording_Click" Margin="7,0,0,0"/>
                </Grid>
                <WrapPanel Margin="0,0,0,10">
                  <CheckBox x:Name="SttMicrophone" Content="Microfono" IsChecked="True" Margin="0,0,16,0"/>
                  <CheckBox x:Name="SttSystem" Content="Audio del PC" IsChecked="True"/>
                </WrapPanel>
                <WrapPanel>
                  <Button x:Name="TranscribeButton" Content="Trascrivi offline" Click="Transcribe_Click"
                          Background="#176F71" Foreground="White" BorderBrush="#176F71" Margin="0,0,8,8"/>
                  <Button x:Name="CancelTranscribeButton" Content="Annulla trascrizione"
                          Click="CancelTranscribe_Click" IsEnabled="False" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock x:Name="SttStatusText" Text="Il modello va scaricato una sola volta e selezionato."
                           Foreground="#647887" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border x:Name="ConsentPanel" Background="#F3F7F7" CornerRadius="8" Padding="12" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="ConsentInput"
                          Content="Autorizzo l'invio del testo al provider selezionato"
                          FontSize="12" FontWeight="SemiBold" Foreground="#173044"/>
                <TextBlock Text="Il CLI può inviare il testo al cloud aziendale. Usa solo trascrizioni consentite dalle policy."
                           Foreground="#647887" FontSize="11" TextWrapping="Wrap" Margin="23,7,0,0"/>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="GenerateButton" Content="Genera minuta" Click="Generate_Click"
                      Background="#176F71" Foreground="White" BorderBrush="#176F71"
                      FontWeight="SemiBold" Padding="19,11"/>
              <Button x:Name="CancelButton" Content="Annulla" IsEnabled="False"
                      Click="Cancel_Click" Margin="9,0,0,0" Padding="15,11"/>
            </StackPanel>

            <TextBlock Text="WAV e trascrizioni restano locali. Solo la generazione con un CLI IA invia il testo al provider selezionato."
                       Foreground="#647887" FontSize="11" TextWrapping="Wrap" Margin="0,20,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="White" BorderBrush="#DCE6EA" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22,20,22,21">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Anteprima minuta" FontSize="17" FontWeight="Bold"/>
          <TextBlock Grid.Row="1" Text="Contenuto pronto da rivedere prima di inviarlo."
                     Foreground="#647887" Margin="0,5,0,13"/>
          <TextBox Grid.Row="2" x:Name="PreviewInput"
                   Text="Importa una trascrizione e genera la prima minuta.&#10;&#10;Il testo apparirà qui. Potrai copiarlo negli appunti o aprire il file HTML per Outlook."
                   IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   Padding="16" Background="#FAFCFC" BorderBrush="#DFE8EB"
                   FontSize="13" FontFamily="Segoe UI"/>
          <WrapPanel Grid.Row="3" Margin="0,15,0,0">
            <Button x:Name="CopyOutlookButton" Content="Copia per Outlook" Click="CopyOutlook_Click"
                    IsEnabled="False" Background="#176F71" Foreground="White" BorderBrush="#176F71"
                    Margin="0,0,8,8"/>
            <Button x:Name="CopyTextButton" Content="Copia testo" Click="CopyText_Click"
                    IsEnabled="False" Margin="0,0,8,8"/>
            <Button x:Name="OpenHtmlButton" Content="Apri HTML" Click="OpenHtml_Click"
                    IsEnabled="False" Margin="0,0,8,8"/>
            <Button x:Name="OpenFolderButton" Content="Apri cartella" Click="OpenFolder_Click"
                    IsEnabled="False" Margin="0,0,8,8"/>
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="#DCE6EA" BorderThickness="0,1,0,0"
            Padding="25,11">
      <DockPanel>
        <TextBlock Text="v0.3 · Trascrizione offline · WAV → TXT → minuta Outlook"
                   DockPanel.Dock="Right" Foreground="#647887" HorizontalAlignment="Right" FontSize="11"/>
        <TextBlock x:Name="StatusText" Text="Pronto · Nessun dato inviato" FontSize="12"
                   Foreground="#176F71" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
