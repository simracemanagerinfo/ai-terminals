<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MeetingNotes</AssemblyName>
    <RootNamespace>MeetingNotes</RootNamespace>
    <Version>0.4.0</Version>
    <ApplicationIcon>Resources\MeetingNotes.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="transcriber\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\MeetingNotes.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\scripts\meetings\Invoke-MeetingMinutes.ps1">
      <Link>scripts\Invoke-MeetingMinutes.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\scripts\meetings\Invoke-MeetingProvider.ps1">
      <Link>scripts\Invoke-MeetingProvider.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="GenerateMeetingNotesIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\meetings\New-MeetingNotesIcon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\Resources\MeetingNotes.ico&quot;" />
  </Target>
</Project>
