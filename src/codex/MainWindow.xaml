<Window x:Class="ClaudeTerminal.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Codex Terminal" Width="1280" Height="830" MinWidth="850" MinHeight="550"
        Background="#10181D" Foreground="#DEEAF0" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#22333B"/>
      <Setter Property="Foreground" Value="#F1FBFC"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1D3037"/>
      <Setter Property="Foreground" Value="#F1FBFC"/>
      <Setter Property="BorderBrush" Value="#375660"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="9"/>
      <Setter Property="Margin" Value="0,2,0,3"/>
      <Setter Property="Background" Value="#1C2A31"/>
      <Setter Property="Foreground" Value="#ECF8F9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#275767"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsUnread}" Value="True">
          <Setter Property="Background" Value="#205962"/>
          <Setter Property="BorderBrush" Value="#66EEE7"/>
          <Setter Property="BorderThickness" Value="2"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="310"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#14232A" BorderBrush="#2D4E59" BorderThickness="0,0,1,0">
      <DockPanel Margin="15">
        <TextBlock DockPanel.Dock="Bottom" x:Name="SideStatus"
                   Margin="0,14,0,2" TextWrapping="Wrap" Foreground="#9BACB3"
                   Text="Scegli un progetto. Nessuna sessione attiva." FontSize="11"/>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="CODEX TERMINAL" Foreground="#5DAEB5" FontWeight="Bold" FontSize="18" Margin="0,0,0,3"/>
          <TextBlock Text="CONPTY · MULTISESSIONE" Foreground="#92A8B0" FontSize="11" Margin="0,0,0,16"/>
          <TextBlock Text="Progetto" Margin="0,0,0,6" FontWeight="SemiBold"/>
          <ComboBox x:Name="ProjectCombo" Height="32" IsEditable="True" Margin="0,0,0,9"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
            <Button x:Name="BrowseButton" Content="Sfoglia..." Click="Browse_Click"/>
            <Button x:Name="OpenProjectButton" Content="Apri progetto" Background="#5DAEB5" Click="OpenProject_Click"/>
          </StackPanel>
          <DockPanel Margin="0,0,0,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Cerca" Padding="8,3" Click="SearchToggle_Click" ToolTip="Mostra/nascondi ricerca (Ctrl+F)"/>
              <Button Content="↻" Padding="9,3" Click="RefreshHistory_Click" ToolTip="Aggiorna storico dal disco"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="CONVERSAZIONI" Foreground="#8DCCD1" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock x:Name="LiveCount" Text="  0 attive" Foreground="#89A7B1" FontSize="12"/>
            </StackPanel>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="NewSessionButton" Content="+ Nuova conversazione" Click="NewSession_Click"
                    Background="#5DAEB5" Padding="16,9"/>
          </StackPanel>
          <TextBox x:Name="ConversationFilter" TextChanged="ConversationFilter_TextChanged"
                   Visibility="Collapsed" ToolTip="Cerca tra sessioni attive e storico"
                   Margin="0,0,0,8"/>
        </StackPanel>
        <ListBox x:Name="ConversationsList"
                 SelectionChanged="ConversationsList_SelectionChanged"
                 MouseDoubleClick="ConversationsList_MouseDoubleClick"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxHeight="48"/>
                <TextBlock Text="{Binding Detail}" Foreground="#B5C9D0"
                           TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#142028" BorderBrush="#31515B" BorderThickness="0,0,0,1">
        <DockPanel Margin="15,0" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Token" Click="Usage_Click" Background="#346A78" ToolTip="Consumi locali Codex"/>
            <Button Content="Riprendi" Click="ResumeHistory_Click" Background="#305261"/>
            <Button Content="Chiudi sessione" Click="CloseSession_Click" Background="#313D4D"/>
          </StackPanel>
          <TextBlock x:Name="ActiveTitle" Text="Nessuna conversazione"
                     VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#D1F1F4"/>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" BorderBrush="#2B4854" BorderThickness="1" Margin="10" Background="#0D161C">
        <wv2:WebView2 x:Name="TerminalView"/>
      </Border>
      <TextBlock Grid.Row="2" x:Name="FooterStatus" Margin="15,0"
                 Foreground="#9BAFB5" FontSize="11" VerticalAlignment="Center"
                 Text="Avvio renderer locale..."/>
    </Grid>
  </Grid>
</Window>
