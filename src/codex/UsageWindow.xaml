<Window x:Class="ClaudeTerminal.Host.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utilizzo token — Codex" Width="1140" Height="680"
        MinWidth="870" MinHeight="500" Background="#10181D" Foreground="#DEEAF0"
        FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#29515E"/>
      <Setter Property="Foreground" Value="#F1FBFC"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#DEEAF0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Ricalcola" Click="Refresh_Click" Background="#5DAEB5"/>
        <Button Content="Chiudi" Click="Close_Click"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Utilizzo token locale" FontSize="22" FontWeight="Bold" Foreground="#8CD7DA"/>
        <TextBlock Text="Codex CLI · statistiche dai file JSONL locali"
                   Foreground="#BFA796" FontSize="12" Margin="0,6,0,0"/>
      </StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Agente" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="ProviderFilter" Width="126" Margin="0,0,18,0"
                Background="#352721" Foreground="Black" SelectionChanged="Filter_Changed">
        <ComboBoxItem Content="Codex" IsSelected="True"/>
      </ComboBox>
      <TextBlock Text="Ambito" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="ScopeFilter" Width="170"
                Background="#352721" Foreground="Black" SelectionChanged="Filter_Changed">
        <ComboBoxItem Content="Tutti i progetti" IsSelected="True"/>
        <ComboBoxItem Content="Progetto corrente"/>
      </ComboBox>
      <TextBlock x:Name="ScanStatus" Text="Lettura dati locali..." Foreground="#BA9A89"
                 VerticalAlignment="Center" Margin="20,0,0,0"/>
    </StackPanel>
    <Border Grid.Row="2" Background="#182B34" CornerRadius="8" Padding="14" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock x:Name="TotalLabel" Text="Token totali: —" FontSize="23" FontWeight="Bold"
                   Foreground="#80CDD2"/>
        <WrapPanel Margin="0,8,0,0">
          <TextBlock x:Name="InputLabel" Margin="0,0,24,0"/>
          <TextBlock x:Name="CacheReadLabel" Margin="0,0,24,0"/>
          <TextBlock x:Name="CacheWriteLabel" Margin="0,0,24,0"/>
          <TextBlock x:Name="OutputLabel" Margin="0,0,24,0"/>
          <TextBlock x:Name="ReasoningLabel" Margin="0,0,24,0"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <DataGrid Grid.Row="3" x:Name="UsageGrid" AutoGenerateColumns="False"
              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
              Background="#211A17" Foreground="#DEEAF0"
              RowBackground="#211A17" AlternatingRowBackground="#2C231D"
              HeadersVisibility="Column" GridLinesVisibility="None"
              BorderThickness="1" BorderBrush="#49352B"
              SelectionMode="Single" SelectionUnit="FullRow"
              EnableRowVirtualization="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Agente" Binding="{Binding Provider}" Width="77"/>
        <DataGridTextColumn Header="Progetto" Binding="{Binding Project}" Width="*"/>
        <DataGridTextColumn Header="Sessione" Binding="{Binding Session}" Width="120"/>
        <DataGridTextColumn Header="Modello" Binding="{Binding Model}" Width="135"/>
        <DataGridTextColumn Header="Input" Binding="{Binding Input, StringFormat={}{0:N0}}" Width="98"/>
        <DataGridTextColumn Header="Cache letta" Binding="{Binding CacheRead, StringFormat={}{0:N0}}" Width="110"/>
        <DataGridTextColumn Header="Cache scritta" Binding="{Binding CacheWrite, StringFormat={}{0:N0}}" Width="110"/>
        <DataGridTextColumn Header="Output" Binding="{Binding Output, StringFormat={}{0:N0}}" Width="97"/>
        <DataGridTextColumn Header="Ragionamento" Binding="{Binding Reasoning, StringFormat={}{0:N0}}" Width="114"/>
        <DataGridTextColumn Header="Totale" Binding="{Binding Total, StringFormat={}{0:N0}}" Width="110"/>
        <DataGridTextColumn Header="Ultima attività" Binding="{Binding DateLabel}" Width="132"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Margin="0,12,0,0">
      <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#BBA497"
                 Text="Misure ricostruite dai transcript ancora presenti sul PC: non rappresentano quota residua o fatturazione dell’account. I token di cache Codex sono già inclusi nell’input; il ragionamento è incluso nell’output. I costi non sono stimati."/>
      <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="#F2A88E" Margin="0,7,0,0"/>
    </StackPanel>
  </Grid>
</Window>
